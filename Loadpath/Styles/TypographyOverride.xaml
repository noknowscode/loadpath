<!--
  Loadpath: the type scale. The Simple theme reads it through App.xaml (SimpleToolkitTheme.FontOverrideSource) on top of
  DefaultFontFamily (Inter, set on the theme), so every semantic text style (BodyMedium, LabelSmall...), the theme's
  controls and the app's text styles (Themes/Controls.xaml) take the design's sizes and weights from here.

  The design's ramp is 11 12 13 14 22 (11 px is the floor, SPEC): Inter for UI text, JetBrains Mono for every number and
  the drawing-sheet labels. Both ship as static Regular and Medium faces; a font manifest beside each regular face
  (Assets/Fonts/*.ttf.manifest) maps FontWeight to the face, so one family plus a weight picks the right file.

    Style            Size  Weight  Used for
    HeadlineSmall    22    Medium  the inspector's title, the empty state's line
    LabelLarge       14    Medium  the wordmark (mono)
    LabelMedium      13    Medium  strong body (a member's force kind)
    LabelSmall       12    Medium  button and segment labels, ids, sheet titles (mono)
    LabelExtraSmall  11    Medium  section labels (mono)
    BodyLarge        13    Regular the theme's controls: menus, check boxes, the combo box
    BodyMedium       13    Regular body text, values (mono)
    BodySmall        12    Regular captions, secondary figures (mono)
    CaptionLarge     13    Regular (as BodyMedium)
    CaptionMedium    12    Regular (as BodySmall)
    CaptionSmall     11    Regular micro text: pills, keycaps, counts (mono)
  Display, Headline Large/Medium and Title keep the theme's sizes; the design does not use them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The design's second family. Text styles take it through Themes/Controls.xaml, the canvas through CanvasTypefaces -->
  <FontFamily x:Key="MonoFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

  <x:Double x:Key="HeadlineSmallFontSize">22</x:Double>
  <x:String x:Key="HeadlineSmallFontWeight">Medium</x:String>

  <x:Double x:Key="LabelLargeFontSize">14</x:Double>
  <x:String x:Key="LabelLargeFontWeight">Medium</x:String>
  <x:Double x:Key="LabelMediumFontSize">13</x:Double>
  <x:String x:Key="LabelMediumFontWeight">Medium</x:String>
  <x:Double x:Key="LabelSmallFontSize">12</x:Double>
  <x:String x:Key="LabelSmallFontWeight">Medium</x:String>
  <x:Double x:Key="LabelExtraSmallFontSize">11</x:Double>
  <x:String x:Key="LabelExtraSmallFontWeight">Medium</x:String>

  <x:Double x:Key="BodyLargeFontSize">13</x:Double>
  <x:String x:Key="BodyLargeFontWeight">Normal</x:String>
  <x:Double x:Key="BodyMediumFontSize">13</x:Double>
  <x:String x:Key="BodyMediumFontWeight">Normal</x:String>
  <x:Double x:Key="BodySmallFontSize">12</x:Double>
  <x:String x:Key="BodySmallFontWeight">Normal</x:String>

  <x:Double x:Key="CaptionLargeFontSize">13</x:Double>
  <x:String x:Key="CaptionLargeFontWeight">Normal</x:String>
  <x:Double x:Key="CaptionMediumFontSize">12</x:Double>
  <x:String x:Key="CaptionMediumFontWeight">Normal</x:String>
  <x:Double x:Key="CaptionSmallFontSize">11</x:Double>
  <x:String x:Key="CaptionSmallFontWeight">Normal</x:String>

</ResourceDictionary>
