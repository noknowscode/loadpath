<!--
  Loadpath: the palette. The one file that holds the design's role colours; the Simple theme reads it through App.xaml
  (SimpleToolkitTheme.Colors > ThemeColors.OverrideSource) and generates every role brush from it (PrimaryBrush,
  OnSurfaceVariantBrush, OutlineVariantBrush and their Hover, Pressed, Medium... variants), so Uno Platform Studio's
  Themes tab, which edits this file, recolours the whole app, the drawing on the canvas included. The design gives a
  full Light and Dark table, so every role is set here and no generated colour reaches the screen.

  Two themes, one identity:
    Light: the blueprint sheet. Paper #F7F8FB, near-black ink, blueprint-blue structure.
    Dark:  the drafting table at night. Deep blue-slate paper, chalk-white ink, the structure in a lighter blueprint blue
           so it keeps the same hue and reads at the same weight. Not an inversion: surfaces step up in lightness the way
           paper sits on a desk, and the failure red is re-picked for a dark ground.

  Where the design's tokens went:
    Canvas, Surface       -> Background (the sheet: page, title and status strips), Surface (panels, sheets, menus,
                             the floating tool rail and bar)
    SurfaceRaised         -> SurfaceVariant (raised fills: the command palette, the status chip); hover fills too
                             (SurfaceHover folds in here: #ECEEF7 / #1B2130 against #EEF0F7 / #181D27)
    SurfaceHover          -> TertiaryContainer (the theme's pressed fill)
    Ink                   -> OnSurface, OnBackground (text and marks), SurfaceInverse (the ink ground of tooltips and
                             toasts), OnPrimaryContainer (ink on the selection wash)
    InkSecondary, Ok      -> OnSurfaceVariant (secondary text; InkTertiary, the hint ink, folds in here)
    InkTertiary           -> Tertiary
    Accent                -> Primary: the brand and the blueprint ink, so the structure, its forces (tension and
                             compression are told apart by line style, not colour), supports, loads and dimensions
                             are drawn in it. Construction lines and grid marks are Primary blended into the paper
                             (App.xaml, CanvasConstructionAlpha and CanvasGridAlpha).
    AccentInk             -> OnPrimary
    AccentSoft, Selection -> PrimaryContainer (the selected row, the active tool and segment, the reduce-noise frame)
    AccentBorder          -> PrimaryVariantLight (the active tool's outline)
    Danger                -> Error (over capacity, mechanism, delete); DangerSoft -> ErrorContainer, and DangerBorder
                             is ErrorLowBrush (Error at 32 %) on it
    ControlBorder         -> Outline (the 3:1 edge of an input: field, combo box, check box, switch track)
    HairlineStrong        -> OutlineVariant (panel edges, pills, keycaps, segment frames); Hairline, the dashed rules
                             and grid lines inside panels, is OutlineVariantMediumBrush (OutlineVariant at 64 %)
    HoverWash             -> OnSurfaceHoverBrush (an 8 % ink film over any fill; was 5 % in Light)
  Warn (the amber step of the utilization ramp) has no role: it is App.xaml's WarnBrush.
  Secondary has no design token: it is the slate of the secondary ink, with the raised surface as its container.

  Text contrast (WCAG, on Background / on PrimaryContainer): Light OnSurface 16.9, OnSurfaceVariant 7.3 / 6.4,
  Primary 6.6, Error 5.5 (4.7 on ErrorContainer), OnPrimary 7.0 on Primary. Dark OnSurface 15.2, OnSurfaceVariant
  8.5 / 7.0, Primary 7.6, Error 6.8 (5.6 on ErrorContainer), OnPrimary 7.8 on Primary. Non-text (WCAG 1.4.11): Outline
  3.6 on Background and 3.1 on PrimaryContainer in Light, 3.8 and 3.1 in Dark.

  "Default" is the Dark dictionary (the WinUI convention).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <!-- Light: the blueprint sheet -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#FF3446D6</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#FFE5E8FA</Color>
      <Color x:Key="OnPrimaryContainerColor">#FF15171A</Color>
      <Color x:Key="PrimaryInverseColor">#FF8FA0FF</Color>
      <!-- The filled button's hover and press: the accent under the 8 % ink film -->
      <Color x:Key="PrimaryVariantDarkColor">#FF3142C7</Color>
      <Color x:Key="PrimaryVariantLightColor">#FF9AA6E8</Color>

      <Color x:Key="SecondaryColor">#FF4D535C</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#FFEEF0F7</Color>
      <Color x:Key="OnSecondaryContainerColor">#FF15171A</Color>
      <Color x:Key="SecondaryVariantDarkColor">#FF15171A</Color>
      <Color x:Key="SecondaryVariantLightColor">#FF7C8399</Color>

      <Color x:Key="TertiaryColor">#FF5F656F</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#FFECEEF7</Color>
      <Color x:Key="OnTertiaryContainerColor">#FF15171A</Color>

      <Color x:Key="ErrorColor">#FFC42323</Color>
      <Color x:Key="OnErrorColor">#FFFFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#FFFBE2E2</Color>
      <Color x:Key="OnErrorContainerColor">#FFC42323</Color>

      <Color x:Key="BackgroundColor">#FFF7F8FB</Color>
      <Color x:Key="OnBackgroundColor">#FF15171A</Color>

      <Color x:Key="SurfaceColor">#FFF7F8FB</Color>
      <Color x:Key="OnSurfaceColor">#FF15171A</Color>
      <Color x:Key="SurfaceVariantColor">#FFEEF0F7</Color>
      <Color x:Key="OnSurfaceVariantColor">#FF4D535C</Color>
      <Color x:Key="SurfaceInverseColor">#FF15171A</Color>
      <Color x:Key="OnSurfaceInverseColor">#FFF7F8FB</Color>
      <Color x:Key="SurfaceTintColor">#FF3446D6</Color>

      <Color x:Key="OutlineColor">#FF7C8399</Color>
      <Color x:Key="OutlineVariantColor">#FFAEB5CC</Color>
      <Color x:Key="ShadowColor">#3315171A</Color>
    </ResourceDictionary>

    <!-- Dark (Default): the drafting table at night -->
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#FF8FA0FF</Color>
      <Color x:Key="OnPrimaryColor">#FF0C1020</Color>
      <Color x:Key="PrimaryContainerColor">#FF1D2540</Color>
      <Color x:Key="OnPrimaryContainerColor">#FFE6E9F0</Color>
      <Color x:Key="PrimaryInverseColor">#FF3446D6</Color>
      <!-- An ink film would vanish on a dark ground: the hover is an 8 % chalk film, which lightens the accent -->
      <Color x:Key="PrimaryVariantDarkColor">#FF96A6FE</Color>
      <Color x:Key="PrimaryVariantLightColor">#FF4B5BB0</Color>

      <Color x:Key="SecondaryColor">#FFA9B1BF</Color>
      <Color x:Key="OnSecondaryColor">#FF10141B</Color>
      <Color x:Key="SecondaryContainerColor">#FF181D27</Color>
      <Color x:Key="OnSecondaryContainerColor">#FFE6E9F0</Color>
      <Color x:Key="SecondaryVariantDarkColor">#FFE6E9F0</Color>
      <Color x:Key="SecondaryVariantLightColor">#FF68728A</Color>

      <Color x:Key="TertiaryColor">#FF8F98A8</Color>
      <Color x:Key="OnTertiaryColor">#FF10141B</Color>
      <Color x:Key="TertiaryContainerColor">#FF1B2130</Color>
      <Color x:Key="OnTertiaryContainerColor">#FFE6E9F0</Color>

      <Color x:Key="ErrorColor">#FFFF6E6A</Color>
      <Color x:Key="OnErrorColor">#FF10141B</Color>
      <Color x:Key="ErrorContainerColor">#FF3A1C20</Color>
      <Color x:Key="OnErrorContainerColor">#FFFF6E6A</Color>

      <Color x:Key="BackgroundColor">#FF10141B</Color>
      <Color x:Key="OnBackgroundColor">#FFE6E9F0</Color>

      <Color x:Key="SurfaceColor">#FF10141B</Color>
      <Color x:Key="OnSurfaceColor">#FFE6E9F0</Color>
      <Color x:Key="SurfaceVariantColor">#FF181D27</Color>
      <Color x:Key="OnSurfaceVariantColor">#FFA9B1BF</Color>
      <Color x:Key="SurfaceInverseColor">#FFE6E9F0</Color>
      <Color x:Key="OnSurfaceInverseColor">#FF10141B</Color>
      <Color x:Key="SurfaceTintColor">#FF8FA0FF</Color>

      <Color x:Key="OutlineColor">#FF68728A</Color>
      <Color x:Key="OutlineVariantColor">#FF3D465A</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
