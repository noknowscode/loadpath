<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Five heads. Uno.Sdk skips the ones the build OS can't build (iOS off macOS, Windows off Windows). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!--
      App-only override for single-head builds (CI, RID-specific publish): -p:LoadpathTargetFrameworks=net10.0-desktop.
      A global -p:TargetFrameworks would also reach Loadpath.Core, a plain net10.0 library.
    -->
    <TargetFrameworks Condition="'$(LoadpathTargetFrameworks)' != ''">$(LoadpathTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>Loadpath</ApplicationTitle>
    <ApplicationId>com.loadpath.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Loadpath</ApplicationPublisher>
    <Description>Loadpath: a 2D truss workbench that solves as you draw.</Description>

    <!--
      SkiaRenderer: the workspace is an SKCanvasElement.
      MVUX: the presentation model (Uno.Extensions.Reactive).
      Toolkit: utu:Responsive and ResponsiveView for the width layouts. Only the helpers and controls are used;
      ToolkitResources is not merged, so Fluent (XamlControlsResources) plus the app's own tokens and control
      styles stay the only control theme. No Material, no Extensions hosting: the app has three services.
    -->
    <UnoFeatures>
      SkiaRenderer;
      MVUX;
      Toolkit;
    </UnoFeatures>
  </PropertyGroup>

  <!--
    WinAppSDK: SKCanvasElement (the workspace) needs an x64 or ARM64 build, never AnyCPU.
    Uno 7's WinUI libraries need WinRT.Runtime 2.3.1; the default 19041 projection brings 2.2.0 (CS1705).
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Loadpath.Core/Loadpath.Core.csproj" />
  </ItemGroup>
</Project>
