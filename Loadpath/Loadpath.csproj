<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>Loadpath</ApplicationTitle>
    <ApplicationId>com.loadpath.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Loadpath</ApplicationPublisher>
    <Description>Loadpath: a 2D truss workbench that solves as you draw.</Description>

    <!--
      SkiaRenderer: the workspace is an SKCanvasElement.
      MVUX: the presentation model (Uno.Extensions.Reactive).
      Toolkit: utu:Responsive and ResponsiveView for the width layouts. Only the helpers and controls are used;
      ToolkitResources is not merged, so Fluent (XamlControlsResources) plus the app's own tokens and control
      styles stay the only control theme. No Material, no Extensions hosting: the app has three services.
    -->
    <UnoFeatures>
      SkiaRenderer;
      MVUX;
      Toolkit;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Loadpath.Core/Loadpath.Core.csproj" />
  </ItemGroup>
</Project>
