<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Five heads. Uno.Sdk skips the ones the build OS can't build (iOS off macOS, Windows off Windows). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!-- One head at a time (CI, RID-specific publish): -p:LoadpathTargetFrameworks=net10.0-desktop. -->
    <TargetFrameworks Condition="'$(LoadpathTargetFrameworks)' != ''">$(LoadpathTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>Loadpath</ApplicationTitle>
    <ApplicationId>com.loadpath.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Loadpath</ApplicationPublisher>
    <Description>Loadpath: a 2D truss workbench that solves as you draw.</Description>

    <!--
      SkiaRenderer: the workspace is an SKCanvasElement.
      MVUX: the presentation model (Uno.Extensions.Reactive).
      Hosting, Logging: the app's services live in one container (AppServices) and log through ILogger.
      ThemeService: IThemeService puts the saved theme choice on the window.
      Toolkit: utu:Responsive and ResponsiveView for the width layouts, utu:SafeArea for the phone's system bars. Only
      the helpers are used; ToolkitResources is not merged, so Fluent (XamlControlsResources) plus the app's own tokens
      and control styles stay the only control theme. No Material.
    -->
    <UnoFeatures>
      SkiaRenderer;
      MVUX;
      Hosting;
      Logging;
      ThemeService;
      Toolkit;
    </UnoFeatures>
    <!--
      Uno.Sdk 7.0.0-dev.115 bundles Hot Design 2.0.0-dev.31 and App MCP 2.0.0-dev.18, whose clients still reference
      Uno.UI.Lottie, an assembly Uno 7 no longer ships: every Debug launch crashed in GlobalStaticResources. Both stay off
      (Debug only; Release never had them) until a dev build drops the reference. Delete these three lines then.
    -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <DefineConstants>$(DefineConstants);NO_UNO_STUDIO</DefineConstants>
  </PropertyGroup>

  <!--
    WinAppSDK: SKCanvasElement (the workspace) needs an x64 or ARM64 build, never AnyCPU.
    Uno 7's WinUI libraries need WinRT.Runtime 2.3.1; the default 19041 projection brings 2.2.0 (CS1705).
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
  </PropertyGroup>

  <!--
    WebAssembly: the unsaved-changes prompt (BrowserUnloadGuard). Its JSImport interop is generated as unsafe code, and
    Uno.Sdk embeds only AppManifest.js from WasmScripts by default, so the script that arms the prompt is listed here.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/UnsavedChanges.js" />
  </ItemGroup>

</Project>
