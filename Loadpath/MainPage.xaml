<Page x:Class="Loadpath.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Loadpath.Controls"
      xmlns:v="using:Loadpath.Views"
      xmlns:w="using:Loadpath.Workspace"
      Background="{StaticResource CanvasBrush}">

  <Grid x:Name="Root" Background="{StaticResource CanvasBrush}">
    <!--
      Width breakpoints. The canvas keeps the room: the structure outline yields first, then the inspector,
      then the floating tool palette. AdaptiveTrigger is the platform route; the project takes no Toolkit dependency.
    -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1240" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Medium">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="StructureHost.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="640" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="StructureHost.Visibility" Value="Collapsed" />
            <Setter Target="InspectorShell.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="StructureHost.Visibility" Value="Collapsed" />
            <Setter Target="InspectorShell.Visibility" Value="Collapsed" />
            <Setter Target="Rail.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <v:TitleStrip />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Structure outline -->
      <Border x:Name="StructureHost">
        <!-- Width yields via the VisualState above; Reduce noise can hide the list too (inner binding, so neither overrides the other). -->
        <Border Width="{StaticResource StructureWidth}" c:Motion.Reveal="True" Visibility="{Binding ShowStructureList, Converter={StaticResource Vis}}">
          <v:OutlinePanel x:Name="Outline" />
        </Border>
      </Border>

      <!-- Workspace host: the blueprint sheet below, XAML overlay above. -->
      <Grid Grid.Column="1" x:Name="WorkspaceHost">
        <w:WorkspaceView x:Name="Workspace" AutomationProperties.Name="Structure workspace" />
        <c:KeySink x:Name="KeySink" />

        <!-- Floating tool palette, inside the drawing frame -->
        <v:ToolRail x:Name="Rail" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,24,0,0" />

        <!-- Mechanism / unsupported banner -->

        <!-- xaml-lint: allow card - status banner over the drawing; no Toolkit by README decision -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0" Padding="14,8" CornerRadius="4"
                Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                c:Motion.Reveal="True" Visibility="{Binding Status.IsMechanism, Converter={StaticResource Vis}}" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="warning" Foreground="{StaticResource DangerBrush}" Width="14" Height="14" />
            <TextBlock Text="{Binding Status.MechanismText}" Style="{StaticResource BodyText}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Detached parts notice (warning, not failure) -->

        <!-- xaml-lint: allow card - status banner over the drawing; no Toolkit by README decision -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0" Padding="14,8" CornerRadius="4"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1"
                c:Motion.Reveal="True" Visibility="{Binding Status.HasDetached, Converter={StaticResource Vis}}" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="warning" Foreground="{StaticResource InkSecondaryBrush}" Width="14" Height="14" />
            <TextBlock Text="{Binding Status.DetachedText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Empty state -->
        <!-- A paper plate behind the text so the registration marks do not run through it. -->
        <Border x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource CanvasBrush}" Padding="32,24"
                c:Motion.Reveal="True" Visibility="{Binding Status.IsEmpty, Converter={StaticResource Vis}}">
        <StackPanel Spacing="14" MaxWidth="440">
          <TextBlock Text="Fig. 00" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
          <TextBlock Text="Draw a structure and it answers." Style="{StaticResource DisplayText}" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap">
            <Run Text="Press" /><Run Text=" N " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="and click to place nodes," />
            <Run Text=" M " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="to connect them," />
            <Run Text=" S " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="for supports and" />
            <Run Text=" L " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="for loads. Every change re-solves instantly." />
          </TextBlock>
          <TextBlock Text="Or start from a sample" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Style="{StaticResource OutlineButton}" Content="WARREN TRUSS" Command="{Binding SampleWarren}" AutomationProperties.Name="Load Warren truss sample" />
            <Button Style="{StaticResource OutlineButton}" Content="CANTILEVER" Command="{Binding SampleCantilever}" AutomationProperties.Name="Load cantilever sample" />
            <Button Style="{StaticResource OutlineButton}" Content="HOWE ROOF" Command="{Binding SampleRoof}" AutomationProperties.Name="Load Howe roof sample" />
          </StackPanel>
          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Command="{Binding PasteDesign}" AutomationProperties.Name="Paste a design from a share code">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="OR PASTE A SHARE CODE" VerticalAlignment="Center" />
              <Border Style="{StaticResource Keycap}">
                <TextBlock Text="CTRL SHIFT V" Style="{StaticResource KeycapText}" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>
        </Border>

        <!-- Floating selection bar, positioned by code above the selection -->

        <!-- xaml-lint: allow card - popover chrome; no Toolkit by README decision -->
        <Border x:Name="FloatingBar" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3,3,3">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock Text="{Binding Inspector.SelectionLabel}" Style="{StaticResource MonoCaption}" FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Rectangle Width="1" Height="16" Fill="{StaticResource HairlineBrush}" Margin="0,0,4,0" />
            <Button Style="{StaticResource IconButton}" Command="{Binding CycleSupport}" ToolTipService.ToolTip="Cycle support" Visibility="{Binding Inspector.SelectionHasNodes, Converter={StaticResource Vis}}" AutomationProperties.Name="Cycle support">
              <c:Icon Kind="support" Foreground="{StaticResource AccentBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding AddLoad}" ToolTipService.ToolTip="Add 10 kN load" Visibility="{Binding Inspector.SelectionHasNodes, Converter={StaticResource Vis}}" AutomationProperties.Name="Add load">
              <c:Icon Kind="load" Foreground="{StaticResource AccentBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding SplitMember}" ToolTipService.ToolTip="Split member" Visibility="{Binding Inspector.IsMember, Converter={StaticResource Vis}}" AutomationProperties.Name="Split member">
              <c:Icon Kind="node" Foreground="{StaticResource AccentBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding DuplicateSelection}" ToolTipService.ToolTip="Duplicate   Ctrl+D" AutomationProperties.Name="Duplicate">
              <c:Icon Kind="duplicate" Foreground="{StaticResource AccentBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding DeleteSelection}" ToolTipService.ToolTip="Delete   Del" AutomationProperties.Name="Delete">
              <c:Icon Kind="delete" Foreground="{StaticResource DangerBrush}" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Section drag ghost -->

        <!-- xaml-lint: allow card - drag ghost chip; no Toolkit by README decision -->
        <Border x:Name="DragGhost" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
          <TextBlock x:Name="DragGhostText" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" />
        </Border>

        <!-- Toast -->

        <!-- xaml-lint: allow card - transient toast; no Toolkit by README decision -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64" Padding="14,8" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                Background="{StaticResource InkBrush}">
          <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTranslate" Y="6" />
          </Border.RenderTransform>
          <TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" Foreground="{StaticResource CanvasBrush}" />
        </Border>
      </Grid>

      <!-- Inspector column: the shell yields to width (VisualState above), the host follows the user's toggle (Ctrl+\). -->
      <Border Grid.Column="2" x:Name="InspectorShell">
        <Border x:Name="InspectorHost" Width="{StaticResource InspectorWidth}" c:Motion.Reveal="True" Visibility="{Binding InspectorVisible, Converter={StaticResource Vis}}">
          <v:InspectorPanel x:Name="Inspector" />
        </Border>
      </Border>
    </Grid>

    <v:StatusBar Grid.Row="2" />

    <!-- Command palette overlay -->
    <v:CommandPalette x:Name="Palette" Grid.RowSpan="3" Visibility="{Binding IsPaletteOpen, Converter={StaticResource Vis}}" />
  </Grid>
</Page>
