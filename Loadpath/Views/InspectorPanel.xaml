<UserControl x:Class="Loadpath.Views.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls"
             x:Name="Panel">
  <UserControl.Resources>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Height" Value="32" />
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <!-- One numbered section of the inspector; dashed rules sit between sections. -->
    <Style x:Key="Section" TargetType="StackPanel">
      <Setter Property="Padding" Value="20,18,20,20" />
    </Style>
    <Style x:Key="Rule" TargetType="Rectangle" BasedOn="{StaticResource DashedRule}">
      <Setter Property="Margin" Value="20,0,0,0" />
    </Style>
    <!-- Inspector actions share the 40 px height of its fields and section picker. -->
    <Style x:Key="InspectorAction" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style x:Key="Header" TargetType="StackPanel">
      <Setter Property="Padding" Value="20,22,20,20" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource MonoCaption}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionNumber" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel>

        <!-- ===== Summary ===== -->
        <StackPanel c:Motion.Reveal="True" Visibility="{Binding Inspector.IsSummary, Converter={StaticResource Vis}}">
          <StackPanel Style="{StaticResource Header}">
            <TextBlock Text="INSPECTOR · STRUCTURE" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Inspector.Title}" Style="{StaticResource DisplayText}" />
            <TextBlock Text="{Binding Inspector.Subtitle}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="01" Style="{StaticResource SectionNumber}" /><TextBlock Text="MODEL" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Nodes" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.NodeCountText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Members" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.MemberCountText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Supports" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.SupportsText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Applied load" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.TotalLoadText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Mass" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.MassText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="02" Style="{StaticResource SectionNumber}" /><TextBlock Text="RESULT" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Max utilization" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.MaxUtilText}" Style="{StaticResource ValueText}" Foreground="{Binding Inspector.MaxUtilToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Style="{StaticResource UtilizationBarStyle}" Value="{Binding Inspector.MaxUtil}" Foreground="{Binding Inspector.MaxUtilToneKey, Converter={StaticResource Brush}}" Margin="0,0,0,8" AutomationProperties.Name="Max utilization" />
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Max deflection" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.MaxDeflectionText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
            <Button Style="{StaticResource InspectorAction}" Command="{Binding JumpToCritical}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                    Visibility="{Binding Inspector.HasCritical, Converter={StaticResource Vis}}" AutomationProperties.Name="Jump to critical member">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Kind="target" Width="14" Height="14" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding Inspector.CriticalText, Converter={StaticResource Upper}}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource InspectorAction}" Command="{Binding Lighten}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    c:Motion.Reveal="True" Visibility="{Binding CanLighten, Converter={StaticResource Vis}}"
                    ToolTipService.ToolTip="Lightest same-material section that keeps every member within capacity   Shift+U" AutomationProperties.Name="Lighten members">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="LIGHTEN MEMBERS" VerticalAlignment="Center" />
                <Border Style="{StaticResource Keycap}">
                  <TextBlock Text="SHIFT U" Style="{StaticResource KeycapText}" />
                </Border>
              </StackPanel>
            </Button>
            <!-- Members over capacity, worst first. The failure mode is spelled out; red only reinforces it. -->
            <StackPanel Margin="0,14,0,0" c:Motion.Reveal="True" Visibility="{Binding HasFailures, Converter={StaticResource Vis}}">
              <Grid Margin="0,0,0,4">
                <TextBlock Text="OVER CAPACITY" Style="{StaticResource MonoCaption}" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                <TextBlock Text="{Binding FailuresHeader}" Style="{StaticResource MonoCaption}" FontSize="11" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Failures}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource QuietButton}" Height="44" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Command="{Binding DataContext.SelectMember, ElementName=Panel}" CommandParameter="{Binding Key}"
                            AutomationProperties.Name="{Binding AutomationName}">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MonoCaption}" FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Mode}" Style="{StaticResource MonoCaption}" FontFamily="{StaticResource MonoFontMedium}" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoCaption}" FontSize="10.5" LineHeight="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- xaml-lint: allow card - utilization pill, not a card; no Toolkit by README decision -->
                        <Border Grid.Column="2" Style="{StaticResource DangerPill}">
                          <TextBlock Text="{Binding Util}" Style="{StaticResource MonoCaption}" FontSize="10" LineHeight="14" Foreground="{StaticResource DangerBrush}" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource InspectorAction}" Command="{Binding UpsizeFailing}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                      ToolTipService.ToolTip="Lightest library section that carries each failing member   U" AutomationProperties.Name="Upsize failing members">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="UPSIZE FAILING MEMBERS" VerticalAlignment="Center" />
                  <Border Style="{StaticResource Keycap}">
                    <TextBlock Text="U" Style="{StaticResource KeycapText}" />
                  </Border>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <StackPanel c:Motion.Reveal="True" Visibility="{Binding ShowResultDetails, Converter={StaticResource Vis}}">
            <Rectangle Style="{StaticResource Rule}" Visibility="{Binding Inspector.ReactionsText, Converter={StaticResource VisText}}" />
            <StackPanel Style="{StaticResource Section}" c:Motion.Reveal="True" Visibility="{Binding Inspector.ReactionsText, Converter={StaticResource VisText}}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="03" Style="{StaticResource SectionNumber}" /><TextBlock Text="REACTIONS" Style="{StaticResource SectionLabel}" />
              </StackPanel>
              <TextBlock Text="{Binding Inspector.ReactionsText}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" LineHeight="22" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding Inspector.SummaryHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="20,4,20,20" />
        </StackPanel>

        <!-- ===== Node ===== -->
        <StackPanel c:Motion.Reveal="True" Visibility="{Binding Inspector.IsNode, Converter={StaticResource Vis}}">
          <StackPanel Style="{StaticResource Header}">
            <TextBlock Text="INSPECTOR · NODE" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Inspector.Title}" Style="{StaticResource DisplayText}" />
            <TextBlock Text="{Binding Inspector.NodeDescription}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <TextBlock Text="01" Style="{StaticResource SectionNumber}" /><TextBlock Text="POSITION" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                <c:NumberField Value="{Binding NodeX, Mode=TwoWay}" Unit="m" Decimals="3" Step="0.5" AutomationProperties.Name="Node X" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Y" Style="{StaticResource FieldLabel}" />
                <c:NumberField Value="{Binding NodeY, Mode=TwoWay}" Unit="m" Decimals="3" Step="0.5" AutomationProperties.Name="Node Y" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <TextBlock Text="02" Style="{StaticResource SectionNumber}" /><TextBlock Text="SUPPORT" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <!-- xaml-lint: allow card - segmented control frame; no Toolkit by README decision -->
            <Border Style="{StaticResource SegmentGroup}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource SegmentToggle}" Padding="2,0" Content="NONE" IsChecked="{Binding Inspector.IsFree}" Command="{Binding SupportNone}" AutomationProperties.Name="No support" />
                <Rectangle Grid.Column="1" Fill="{StaticResource HairlineStrongBrush}" />
                <ToggleButton Grid.Column="2" Style="{StaticResource SegmentToggle}" Padding="2,0" Content="PIN" IsChecked="{Binding Inspector.IsPin}" Command="{Binding SupportPin}" AutomationProperties.Name="Pin support" />
                <Rectangle Grid.Column="3" Fill="{StaticResource HairlineStrongBrush}" />
                <ToggleButton Grid.Column="4" Style="{StaticResource SegmentToggle}" Padding="2,0" Content="ROLLER X" IsChecked="{Binding Inspector.IsRoller}" Command="{Binding SupportRoller}"
                              ToolTipService.ToolTip="Fixed in y, free to roll in x" AutomationProperties.Name="Roller support, free in x" />
                <Rectangle Grid.Column="5" Fill="{StaticResource HairlineStrongBrush}" />
                <ToggleButton Grid.Column="6" Style="{StaticResource SegmentToggle}" Padding="2,0" Content="ROLLER Y" IsChecked="{Binding Inspector.IsRollerX}" Command="{Binding SupportRollerX}"
                              ToolTipService.ToolTip="Fixed in x, free to roll in y" AutomationProperties.Name="Roller support, free in y" />
              </Grid>
            </Border>
            <Grid Style="{StaticResource Row}" Margin="0,8,0,0" c:Motion.Reveal="True" Visibility="{Binding Inspector.HasReaction, Converter={StaticResource Vis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Reaction" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.ReactionText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <TextBlock Text="03" Style="{StaticResource SectionNumber}" /><TextBlock Text="LOAD" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="FX" Style="{StaticResource FieldLabel}" />
                <c:NumberField Value="{Binding LoadX, Mode=TwoWay}" Unit="kN" Decimals="1" Step="1" AutomationProperties.Name="Load X" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="FY" Style="{StaticResource FieldLabel}" />
                <c:NumberField Value="{Binding LoadY, Mode=TwoWay}" Unit="kN" Decimals="1" Step="1" AutomationProperties.Name="Load Y" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Negative Fy points down. Drag the arrow tail on the drawing to aim it." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>

          <!-- Result details: a Reduce-noise layer -->
          <StackPanel c:Motion.Reveal="True" Visibility="{Binding ShowResultDetails, Converter={StaticResource Vis}}">
            <Rectangle Style="{StaticResource Rule}" />
            <StackPanel Style="{StaticResource Section}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="04" Style="{StaticResource SectionNumber}" /><TextBlock Text="DISPLACEMENT" Style="{StaticResource SectionLabel}" />
              </StackPanel>
              <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- Direction of travel: center dot, line to the displaced position (fixed length, so small motions still read). -->
                <Grid Width="72" Height="72" VerticalAlignment="Top">
                  <Rectangle Stroke="{StaticResource HairlineStrongBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                  <Canvas Width="70" Height="70">
                    <Line X1="35" Y1="4" X2="35" Y2="66" Stroke="{StaticResource HairlineBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                    <Line X1="4" Y1="35" X2="66" Y2="35" Stroke="{StaticResource HairlineBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                    <Line X1="35" Y1="35" X2="{Binding Inspector.DispDotX}" Y2="{Binding Inspector.DispDotY}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Canvas.Left="32" Canvas.Top="32" />
                    <Ellipse Width="7" Height="7" Fill="{StaticResource CanvasBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Margin="-3.5,-3.5,0,0">
                      <Ellipse.RenderTransform>
                        <TranslateTransform X="{Binding Inspector.DispDotX}" Y="{Binding Inspector.DispDotY}" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                  </Canvas>
                </Grid>
                <StackPanel Grid.Column="1">
                  <Grid Style="{StaticResource Row}" Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="δX" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Inspector.DispXText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Style="{StaticResource Row}" Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="δY" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Inspector.DispYText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Style="{StaticResource Row}" Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="|δ|" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Inspector.DispMagText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
            <Rectangle Style="{StaticResource Rule}" />
            <StackPanel Style="{StaticResource Section}">
              <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="05" Style="{StaticResource SectionNumber}" /><TextBlock Text="CONNECTED MEMBERS" Style="{StaticResource SectionLabel}" />
                </StackPanel>
                <TextBlock Text="{Binding Inspector.ConnectedCountText}" Style="{StaticResource MonoCaption}" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ConnectedMembers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="32" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="48" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource MonoCaption}" FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Endpoints}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Force}" Style="{StaticResource MonoCaption}" Foreground="{Binding ForceToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
                      <!-- xaml-lint: allow card - utilization pill, not a card; no Toolkit by README decision -->
                      <Border Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource PillBorder}" BorderThickness="0"
                              Background="{Binding UtilIsDanger, Converter={StaticResource Pick}, ConverterParameter=DangerSoftBrush|TransparentBrush}">
                        <TextBlock Text="{Binding Util}" Style="{StaticResource MonoCaption}" FontSize="10" LineHeight="14"
                                   Foreground="{Binding UtilIsDanger, Converter={StaticResource Pick}, ConverterParameter=DangerBrush|InkSecondaryBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- ===== Member ===== -->
        <StackPanel c:Motion.Reveal="True" Visibility="{Binding Inspector.IsMember, Converter={StaticResource Vis}}">
          <StackPanel Style="{StaticResource Header}">
            <TextBlock Text="INSPECTOR · MEMBER" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Inspector.Title}" Style="{StaticResource DisplayText}" />
            <TextBlock Text="{Binding Inspector.Subtitle}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="01" Style="{StaticResource SectionNumber}" /><TextBlock Text="GEOMETRY" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Endpoints" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.EndpointsText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Length" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.LengthText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <TextBlock Text="02" Style="{StaticResource SectionNumber}" /><TextBlock Text="SECTION" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" MinHeight="40" Height="40" FontFamily="{StaticResource UiFont}" FontSize="13" AutomationProperties.Name="Section">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontFamily="{StaticResource UiFont}" FontSize="13" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding Inspector.MaterialText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Inspector.AreaText}" Style="{StaticResource MonoCaption}" Margin="0,2,0,0" />
            <TextBlock Text="Drag a section onto any member to apply it." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <!-- The chips overflow one 296 px row; a uniform grid wraps them into rows of four instead of clipping. -->
            <ItemsRepeater ItemsSource="{Binding Sections}" Margin="0,8,0,0">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="68" MinItemHeight="24" MinColumnSpacing="4" MinRowSpacing="4" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <!-- xaml-lint: allow card - draggable section chip; no Toolkit by README decision -->
                  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="2" Padding="6,3" Tag="{Binding Id}"
                          PointerPressed="OnSectionChipPressed" ToolTipService.ToolTip="{Binding Name}">
                    <TextBlock Text="{Binding ShortName}" Style="{StaticResource MonoCaption}" FontSize="11" HorizontalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
          <Rectangle Style="{StaticResource Rule}" />
          <StackPanel Style="{StaticResource Section}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="03" Style="{StaticResource SectionNumber}" /><TextBlock Text="RESULT" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Inspector.ForceKindText}" Style="{StaticResource MediumText}" Foreground="{Binding Inspector.ForceToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.ForceText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Utilization" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Inspector.UtilText}" Style="{StaticResource ValueText}" Foreground="{Binding Inspector.UtilToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Style="{StaticResource UtilizationBarStyle}" Value="{Binding Inspector.Util}" Foreground="{Binding Inspector.UtilToneKey, Converter={StaticResource Brush}}" AutomationProperties.Name="Utilization" />
            <!-- Result details: a Reduce-noise layer -->
            <StackPanel c:Motion.Reveal="True" Visibility="{Binding ShowResultDetails, Converter={StaticResource Vis}}">
              <Grid Style="{StaticResource Row}" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Stress" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Inspector.StressText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding Inspector.GovernsText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Buckling" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Inspector.BucklingText}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
            <Button Style="{StaticResource InspectorAction}" Command="{Binding SplitMember}" Content="SPLIT AT MIDPOINT" Margin="0,12,0,0" AutomationProperties.Name="Split at midpoint" />
          </StackPanel>
        </StackPanel>

        <!-- ===== Mixed ===== -->
        <StackPanel c:Motion.Reveal="True" Visibility="{Binding Inspector.IsMixed, Converter={StaticResource Vis}}">
          <StackPanel Style="{StaticResource Header}">
            <TextBlock Text="INSPECTOR · SELECTION" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Inspector.Title}" Style="{StaticResource DisplayText}" />
            <TextBlock Text="{Binding Inspector.Subtitle}" Style="{StaticResource SecondaryText}" />
            <TextBlock Text="{Binding Inspector.MixedText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel c:Motion.Reveal="True" Visibility="{Binding Inspector.MixedHasNodes, Converter={StaticResource Vis}}">
            <Rectangle Style="{StaticResource Rule}" />
            <StackPanel Style="{StaticResource Section}" Spacing="8">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="01" Style="{StaticResource SectionNumber}" /><TextBlock Text="NODES" Style="{StaticResource SectionLabel}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource InspectorAction}" Content="PIN" Command="{Binding SupportPin}" AutomationProperties.Name="Pin selected nodes" />
                <Button Style="{StaticResource InspectorAction}" Content="ROLLER" Command="{Binding SupportRoller}" AutomationProperties.Name="Roller on selected nodes" />
                <Button Style="{StaticResource InspectorAction}" Content="NO SUPPORT" Command="{Binding SupportNone}" AutomationProperties.Name="Remove supports" />
              </StackPanel>
              <Button Style="{StaticResource InspectorAction}" Content="CLEAR LOADS" Command="{Binding ClearLoads}" AutomationProperties.Name="Clear loads" />
            </StackPanel>
          </StackPanel>
          <StackPanel c:Motion.Reveal="True" Visibility="{Binding Inspector.MixedHasMembers, Converter={StaticResource Vis}}">
            <Rectangle Style="{StaticResource Rule}" />
            <StackPanel Style="{StaticResource Section}" Spacing="4">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="02" Style="{StaticResource SectionNumber}" /><TextBlock Text="MEMBERS · SET SECTION" Style="{StaticResource SectionLabel}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="-9,0"
                            Command="{Binding DataContext.ApplySection, ElementName=Panel}" CommandParameter="{Binding Id}">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: the destructive action, pinned to the bottom of the inspector -->
    <StackPanel Grid.Row="1" c:Motion.Reveal="True" Visibility="{Binding Inspector.IsSummary, Converter={StaticResource Vis}, ConverterParameter=invert}">
      <Rectangle Style="{StaticResource DashedRule}" />
      <Button Style="{StaticResource DangerTextButton}" Command="{Binding DeleteSelection}" Margin="20,10,20,12" AutomationProperties.Name="Delete selection">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Kind="delete" Width="14" Height="14" Foreground="{StaticResource DangerBrush}" />
          <TextBlock Text="DELETE NODE" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Visibility="{Binding Inspector.IsNode, Converter={StaticResource Vis}}" />
          <TextBlock Text="DELETE MEMBER" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Visibility="{Binding Inspector.IsMember, Converter={StaticResource Vis}}" />
          <TextBlock Text="DELETE SELECTION" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Visibility="{Binding Inspector.IsMixed, Converter={StaticResource Vis}}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
