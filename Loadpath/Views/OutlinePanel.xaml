<UserControl x:Class="Loadpath.Views.OutlinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls">
  <UserControl.Resources>
    <!-- Node row: id, coordinates, then support badge and load flush right. A button: Tab reaches it, Enter selects. -->
    <DataTemplate x:Key="NodeRow">
      <Button Style="{StaticResource RowButton}" Background="{Binding RowBrushKey, Converter={StaticResource Brush}}" Tag="{Binding Key}"
              AutomationProperties.Name="{Binding AutomationName}" Click="OnRowClick" PointerEntered="OnRowEntered" PointerExited="OnRowExited">
        <Grid ColumnSpacing="{StaticResource Space125}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource MonoLabel}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource MonoCaption}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
          <Border Grid.Column="2" Style="{StaticResource PillBorder}" HorizontalAlignment="Right" c:Motion.Reveal="True" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Badge}" Style="{StaticResource PillText}" Foreground="{ThemeResource OnSurfaceBrush}" />
          </Border>
          <TextBlock Grid.Column="3" Text="{Binding Value}" Style="{StaticResource MonoSmall}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" TextAlignment="Right" />
        </Grid>
      </Button>
    </DataTemplate>

    <!-- Member row: id, endpoints, force, and a red pill when over capacity. -->
    <DataTemplate x:Key="MemberRow">
      <Button Style="{StaticResource RowButton}" Background="{Binding RowBrushKey, Converter={StaticResource Brush}}" Tag="{Binding Key}"
              AutomationProperties.Name="{Binding AutomationName}" Click="OnRowClick" PointerEntered="OnRowEntered" PointerExited="OnRowExited">
        <Grid ColumnSpacing="{StaticResource Space100}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource MonoLabel}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource MonoCaption}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource MonoCaption}" Foreground="{Binding ValueToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
          <Border Grid.Column="3" Style="{StaticResource DangerPill}" BorderThickness="{StaticResource Space0Thickness}" c:Motion.Reveal="True" Visibility="{Binding HasPill, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding PillText}" Style="{StaticResource PillText}" Foreground="{ThemeResource ErrorBrush}" />
          </Border>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="STRUCTURE" Style="{StaticResource MonoSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Margin="{StaticResource OutlineHeaderMargin}" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel Padding="{StaticResource Space200BottomThickness}">
        <TextBlock Text="No elements yet. Press N to place a node." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="{StaticResource Inset16x4}" Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}}" />

        <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleNodes}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="{StaticResource OutlineGroupInset}" Height="{StaticResource GroupRowHeight}"
                Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}" AutomationProperties.Name="Toggle nodes">
          <Grid ColumnSpacing="{StaticResource Space100}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="{StaticResource IconSizeSmall}">
              <c:Icon Kind="chevron-down" Width="{StaticResource GlyphSizeSmall}" Height="{StaticResource GlyphSizeSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}}" />
              <c:Icon Kind="chevron-right" Width="{StaticResource GlyphSizeSmall}" Height="{StaticResource GlyphSizeSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="01" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="NODES" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding NodesHeader}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <ItemsRepeater TabFocusNavigation="Local" ElementPrepared="OnRowPrepared" ItemsSource="{Binding OutlineNodes}" ItemTemplate="{StaticResource NodeRow}" c:Motion.Reveal="True" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}}" />

        <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleMembers}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="{StaticResource OutlineGroupInset}" Height="{StaticResource GroupRowHeight}" Margin="{StaticResource Space150TopThickness}"
                Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}" AutomationProperties.Name="Toggle members">
          <Grid ColumnSpacing="{StaticResource Space100}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="{StaticResource IconSizeSmall}">
              <c:Icon Kind="chevron-down" Width="{StaticResource GlyphSizeSmall}" Height="{StaticResource GlyphSizeSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}}" />
              <c:Icon Kind="chevron-right" Width="{StaticResource GlyphSizeSmall}" Height="{StaticResource GlyphSizeSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="02" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="MEMBERS" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding MembersHeader}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <ItemsRepeater TabFocusNavigation="Local" ElementPrepared="OnRowPrepared" ItemsSource="{Binding OutlineMembers}" ItemTemplate="{StaticResource MemberRow}" c:Motion.Reveal="True" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
