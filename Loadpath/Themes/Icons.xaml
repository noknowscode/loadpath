<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Loadpath.Controls">
  <!-- Icon: a Viewbox around a stroked Path, so it scales instead of clipping (PathIcon clips on Skia). -->
  <Style TargetType="c:Icon">
    <Setter Property="Width" Value="{StaticResource IconSize}" />
    <Setter Property="Height" Value="{StaticResource IconSize}" />
    <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:Icon">
          <Viewbox Stretch="Uniform">
            <Canvas Width="16" Height="16">
              <Path Data="{TemplateBinding Geometry}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="{TemplateBinding StrokeThickness}"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
