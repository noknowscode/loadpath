<!--
  Loadpath design tokens that no theme carries yet: shell sizes and radii. Colours and type are the
  Simple theme's: the palette is Styles/ColorPaletteOverride.xaml, the type ramp
  Styles/TypographyOverride.xaml, and the colour with no palette role is in App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell sizes -->
  <x:Double x:Key="TitleStripHeight">56</x:Double>
  <x:Double x:Key="StatusBarHeight">40</x:Double>
  <x:Double x:Key="StructureWidth">240</x:Double>
  <x:Double x:Key="InspectorWidth">336</x:Double>

  <CornerRadius x:Key="RadiusNone">0</CornerRadius>
  <CornerRadius x:Key="RadiusHairline">2</CornerRadius>
  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusPopover">6</CornerRadius>
  <CornerRadius x:Key="RadiusPill">9</CornerRadius>
  <CornerRadius x:Key="RadiusRound">16</CornerRadius>
</ResourceDictionary>
