<!--
  Loadpath design tokens. Every color, brush, font and size in the app comes from here (spacing and layout sizes from Layout.xaml).
  Two themes, one identity:
    Light: the blueprint sheet. Paper #F7F8FB, near-black text, blueprint-blue structure.
    Dark:  the drafting table at night. Deep blue-slate paper, chalk-white text, the structure in a lighter blueprint blue
           so it keeps the same hue and reads at the same weight. Not an inversion: surfaces step up in lightness the way
           paper sits on a desk, washes are blue-tinted, and danger and warning are re-picked for a dark ground.
  Pages and styles use {ThemeResource} for every brush here. Code that needs a color (the Skia canvas, the brush-key
  converters) resolves it per theme through Controls/ThemeLookup and re-reads it on ActualThemeChanged.
  "Default" is the dark dictionary, the WinUI convention: High Contrast falls back to it instead of failing to resolve.
  Text contrast (WCAG, measured on Canvas / on Selection): Light Ink 16.9, InkSecondary 7.3, InkTertiary 5.5 / 4.8,
  Accent 6.6, Danger 5.5 (4.7 on DangerSoft), Warn 5.0. Dark Ink 15.2, InkSecondary 8.6, InkTertiary 6.4 / 5.2,
  Accent 7.6, Danger 6.8 (5.6 on DangerSoft), Warn 8.6.
  Force sign is carried by line style (open tension, hatched compression), not by color.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <!-- ===== Light: blueprint sheet ===== -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="CanvasColor">#F7F8FB</Color>
      <Color x:Key="SurfaceColor">#F7F8FB</Color>
      <Color x:Key="SurfaceRaisedColor">#EEF0F7</Color>
      <Color x:Key="SurfaceHoverColor">#ECEEF7</Color>
      <Color x:Key="SelectionColor">#E5E8FA</Color>
      <Color x:Key="HairlineColor">#C9CFE6</Color>
      <Color x:Key="HairlineStrongColor">#AEB5CC</Color>
      <Color x:Key="InkColor">#15171A</Color>
      <Color x:Key="InkSecondaryColor">#4D535C</Color>
      <!-- Was #8B919A (3.0:1); darkened so hints and unit suffixes pass 4.5:1 on every surface they sit on. -->
      <Color x:Key="InkTertiaryColor">#5F656F</Color>
      <Color x:Key="AccentColor">#3446D6</Color>
      <Color x:Key="AccentSoftColor">#E5E8FA</Color>
      <Color x:Key="AccentBorderColor">#9AA6E8</Color>
      <Color x:Key="AccentInkColor">#FFFFFF</Color>
      <Color x:Key="TensionColor">#3446D6</Color>
      <Color x:Key="CompressionColor">#3446D6</Color>
      <Color x:Key="WarnColor">#93600F</Color>
      <Color x:Key="DangerColor">#C42323</Color>
      <Color x:Key="DangerSoftColor">#FBE2E2</Color>
      <Color x:Key="DangerBorderColor">#F2B8B8</Color>
      <Color x:Key="OkColor">#4D535C</Color>
      <!-- Hover wash laid over any fill: a 5 % ink film darkens paper chrome and the accent button alike. -->
      <Color x:Key="HoverWashColor">#0D15171A</Color>
      <!-- Behind the command palette. -->
      <Color x:Key="ScrimColor">#66000000</Color>
      <!-- Canvas only: construction lines (frame, grid crosses, extension and deflected lines) and minor grid dots. -->
      <Color x:Key="ConstructionColor">#B9C1E6</Color>
      <Color x:Key="GridMarkColor">#CDD3EC</Color>

      <!-- Canvas alphas (Skia bakes opacity into paints). Dimmed members, dimmed supports and loads, hover halos,
           the plate behind force labels, the marquee fill, dimension lines and the frame tags. -->
      <x:Double x:Key="CanvasDimAlpha">0.3</x:Double>
      <x:Double x:Key="CanvasDimInkAlpha">0.35</x:Double>
      <x:Double x:Key="CanvasHaloAlpha">0.6</x:Double>
      <x:Double x:Key="CanvasPlateAlpha">0.85</x:Double>
      <x:Double x:Key="CanvasMarqueeAlpha">0.06</x:Double>
      <x:Double x:Key="CanvasDimLineAlpha">0.75</x:Double>
      <x:Double x:Key="CanvasTagAlpha">0.8</x:Double>

      <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
      <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiaryColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="TensionBrush" Color="{StaticResource TensionColor}" />
      <SolidColorBrush x:Key="CompressionBrush" Color="{StaticResource CompressionColor}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
      <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
      <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
      <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
      <SolidColorBrush x:Key="HoverWashBrush" Color="{StaticResource HoverWashColor}" />
      <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />

      <!-- Fluent lightweight keys, so platform controls (check box, combo box, dialog, sub-menu) wear the sheet. -->
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource CanvasColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource CanvasColor}" />
      <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource CanvasColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="{StaticResource InkSecondaryColor}" />
    </ResourceDictionary>

    <!-- ===== Dark (Default): drafting table at night ===== -->
    <ResourceDictionary x:Key="Default">
      <Color x:Key="CanvasColor">#10141B</Color>
      <Color x:Key="SurfaceColor">#10141B</Color>
      <Color x:Key="SurfaceRaisedColor">#181D27</Color>
      <Color x:Key="SurfaceHoverColor">#1B2130</Color>
      <Color x:Key="SelectionColor">#1D2540</Color>
      <Color x:Key="HairlineColor">#262D3B</Color>
      <Color x:Key="HairlineStrongColor">#3D465A</Color>
      <Color x:Key="InkColor">#E6E9F0</Color>
      <Color x:Key="InkSecondaryColor">#A9B1BF</Color>
      <Color x:Key="InkTertiaryColor">#8F98A8</Color>
      <Color x:Key="AccentColor">#8FA0FF</Color>
      <Color x:Key="AccentSoftColor">#1D2540</Color>
      <Color x:Key="AccentBorderColor">#4B5BB0</Color>
      <Color x:Key="AccentInkColor">#0C1020</Color>
      <Color x:Key="TensionColor">#8FA0FF</Color>
      <Color x:Key="CompressionColor">#8FA0FF</Color>
      <Color x:Key="WarnColor">#E3A64B</Color>
      <Color x:Key="DangerColor">#FF6E6A</Color>
      <Color x:Key="DangerSoftColor">#3A1C20</Color>
      <Color x:Key="DangerBorderColor">#7A3437</Color>
      <Color x:Key="OkColor">#A9B1BF</Color>
      <!-- An ink film would vanish on dark chrome: the wash is a 8 % chalk film instead (lightens the accent fill too). -->
      <Color x:Key="HoverWashColor">#14FFFFFF</Color>
      <Color x:Key="ScrimColor">#A6000000</Color>
      <Color x:Key="ConstructionColor">#39446A</Color>
      <Color x:Key="GridMarkColor">#2A3250</Color>

      <!-- Low alphas sink into a dark ground faster than into paper, so dimmed ink stays a little stronger. -->
      <x:Double x:Key="CanvasDimAlpha">0.38</x:Double>
      <x:Double x:Key="CanvasDimInkAlpha">0.42</x:Double>
      <x:Double x:Key="CanvasHaloAlpha">0.7</x:Double>
      <x:Double x:Key="CanvasPlateAlpha">0.9</x:Double>
      <x:Double x:Key="CanvasMarqueeAlpha">0.12</x:Double>
      <x:Double x:Key="CanvasDimLineAlpha">0.8</x:Double>
      <x:Double x:Key="CanvasTagAlpha">0.85</x:Double>

      <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
      <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiaryColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="TensionBrush" Color="{StaticResource TensionColor}" />
      <SolidColorBrush x:Key="CompressionBrush" Color="{StaticResource CompressionColor}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
      <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
      <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
      <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
      <SolidColorBrush x:Key="HoverWashBrush" Color="{StaticResource HoverWashColor}" />
      <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />

      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource HairlineStrongColor}" />
      <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="{StaticResource InkSecondaryColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type: Inter for UI, JetBrains Mono for every number. Static instances; the Skia text stack ignores wght axes. -->
  <FontFamily x:Key="UiFont">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
  <FontFamily x:Key="UiFontMedium">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter Medium</FontFamily>
  <FontFamily x:Key="UiFontSemiBold">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold</FontFamily>
  <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="MonoFontMedium">ms-appx:///Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>

  <!-- Type scale. 11 px is the floor (SPEC); the old 9 / 10 / 10.5 px sizes moved up to it. -->
  <x:Double x:Key="TextMicro">11</x:Double>
  <x:Double x:Key="TextCaption">11</x:Double>
  <x:Double x:Key="TextLabel">12</x:Double>
  <x:Double x:Key="TextBody">13</x:Double>
  <x:Double x:Key="TextValue">13</x:Double>
  <x:Double x:Key="TextWordmark">14</x:Double>
  <x:Double x:Key="TextTitle">15</x:Double>
  <x:Double x:Key="TextDisplay">22</x:Double>

  <!-- Shell sizes -->
  <x:Double x:Key="TitleStripHeight">56</x:Double>
  <x:Double x:Key="StatusBarHeight">40</x:Double>
  <x:Double x:Key="StructureWidth">240</x:Double>
  <x:Double x:Key="InspectorWidth">336</x:Double>

  <CornerRadius x:Key="RadiusHairline">2</CornerRadius>
  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusPopover">6</CornerRadius>
  <CornerRadius x:Key="RadiusPill">9</CornerRadius>
  <CornerRadius x:Key="RadiusRound">16</CornerRadius>
</ResourceDictionary>
