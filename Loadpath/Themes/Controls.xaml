<!-- Control styles. Every interactive element: Normal / PointerOver / Pressed / Disabled, plus visible keyboard focus. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Loadpath.Controls">

  <!-- ===== Text ===== -->
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>
  <!-- Section label: mono, small, the "01 Position" register of the drawing sheet. -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}" />
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="LineHeight" Value="15" />
  </Style>
  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontSemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
    <Setter Property="FontSize" Value="{StaticResource TextDisplay}" />
    <Setter Property="LineHeight" Value="28" />
  </Style>
  <Style x:Key="MediumText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
  </Style>
  <Style x:Key="ValueText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextValue}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>

  <!-- Label above a numeric field (inspector, presets). -->
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MonoCaption}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- ===== Pills (read-only badges) ===== -->
  <Style x:Key="PillBorder" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="DangerPill" TargetType="Border" BasedOn="{StaticResource PillBorder}">
    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="RootScale" />
            </Grid.RenderTransform>
            <!-- Hover wash fades 150 ms, press settles to 0.98, both on EaseSmooth. -->
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusField}" />
            <!-- Hover wash over any background: darkens light chrome and the accent fill alike. -->
            <Border x:Name="Hover" Opacity="0" IsHitTestVisible="False" Background="{StaticResource HoverWashBrush}" CornerRadius="{StaticResource RadiusField}" />
            <ContentPresenter x:Name="ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="-2"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="6" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="38" />
  </Style>

  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="38" />
  </Style>

  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style x:Key="DangerTextButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <!-- Tool palette button: 36 px, icon follows Foreground, single-key label in the bottom-right corner. -->
  <Style TargetType="c:ToolButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ToolButton">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="RootScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <!-- The active tool's wash cross-fades in 150 ms rather than switching. -->
              <VisualStateGroup x:Name="ActiveStates">
                <VisualState x:Name="Inactive">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActiveWash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Active">
                  <VisualState.Setters>
                    <Setter Target="Key.Foreground" Value="{StaticResource AccentBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActiveWash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}" />
            <Border x:Name="ActiveWash" Opacity="0" IsHitTestVisible="False" Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusField}" />
            <Border x:Name="Hover" Opacity="0" IsHitTestVisible="False" Background="{StaticResource HoverWashBrush}" CornerRadius="{StaticResource RadiusField}" />
            <c:Icon x:Name="Glyph" Kind="{TemplateBinding IconKind}" Foreground="{TemplateBinding Foreground}" Width="18" Height="18" Margin="-4,-4,0,0" />
            <TextBlock x:Name="Key" Text="{TemplateBinding KeyLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource InkSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="-2"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="6" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Segment toggle: one cell of a joined segmented control (display mode, support kind). Uppercase mono label;
    the checked cell's accent wash and outline cross-fade in 150 ms on EaseSmooth. The group Border draws the outer frame.
  -->
  <Style x:Key="SegmentToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Label.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Checked">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Label.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" />
            <Border x:Name="Hover" Opacity="0" IsHitTestVisible="False" Background="{StaticResource SurfaceHoverBrush}" />
            <Border x:Name="Wash" Opacity="0" IsHitTestVisible="False" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="1"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Frame around a group of SegmentToggles; cells are separated by 1 px rules placed between them. -->
  <Style x:Key="SegmentGroup" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
  </Style>

  <!--
    Switch toggle (Reduce noise): a 30 x 16 track with a sliding knob, then the label content.
    The knob travels 14 px in 200 ms and the accent track cross-fades in 150 ms, both on EaseSmooth.
    Built on ToggleButton rather than ToggleSwitch so the whole labelled cell is the hit target and sits inside a split control.
  -->
  <Style x:Key="SwitchToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Body.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Checked">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Body.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Opacity="0" Background="{StaticResource SurfaceHoverBrush}" />
            <StackPanel x:Name="Body" Orientation="Horizontal" Spacing="10" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
              <Grid Width="30" Height="16" VerticalAlignment="Center">
                <Rectangle RadiusX="8" RadiusY="8" Fill="{StaticResource HairlineStrongBrush}" />
                <Rectangle x:Name="TrackOn" Opacity="0" RadiusX="8" RadiusY="8" Fill="{StaticResource AccentBrush}" />
                <Ellipse Width="12" Height="12" Fill="{StaticResource AccentInkBrush}" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="KnobShift" X="0" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="1"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Keycap: a keyboard hint ("F", "CTRL K") inside a button or label. -->
  <Style x:Key="Keycap" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="KeycapText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LineHeight" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>

  <!-- Dashed rule: the sheet's separator. A zero-height rectangle so its top and bottom strokes coincide. -->
  <Style x:Key="DashedRule" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Stroke" Value="{StaticResource HairlineBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- CheckBox: lightweight keys only, so the platform template keeps its states and accessibility. -->
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource HairlineStrongColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource InkSecondaryColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource InkColor}" />

  <Style x:Key="LayerCheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Sheet flyout: paper surface, hairline frame, no inner padding (content owns its gutters). -->
  <Style x:Key="SheetFlyoutPresenter" TargetType="FlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MaxWidth" Value="400" />
    <Setter Property="MaxHeight" Value="760" />
  </Style>

  <!-- Numeric field: mono value, unit suffix supplied by the NumberField control around it. -->
  <Style x:Key="FieldTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextValue}" />
    <Setter Property="Padding" Value="10,3,10,3" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <!-- Border colour cross-fades (ink on hover, accent on focus) in 150 ms rather than switching. -->
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ScrollViewer x:Name="ContentElement"
                            HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            IsTabStop="False" ZoomMode="Disabled"
                            Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="HoverEdge" Opacity="0" IsHitTestVisible="False" BorderBrush="{StaticResource InkBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
            <Border x:Name="FocusEdge" Opacity="0" IsHitTestVisible="False" BorderBrush="{StaticResource AccentBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextValue}" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- ===== Menus, tooltips ===== -->
  <Style TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPopover}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="180" />
  </Style>

  <Style TargetType="MenuFlyoutItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuFlyoutItem">
          <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Content.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Opacity="0" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="{StaticResource RadiusField}" />
            <Grid x:Name="Content" ColumnSpacing="16" Padding="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TextBlock" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" />
              <TextBlock x:Name="KeyboardAcceleratorTextBlock" Grid.Column="1" Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                         Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuFlyoutSeparator">
    <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuFlyoutSeparator">
          <Rectangle Fill="{TemplateBinding Background}" Height="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource InkBrush}" />
    <Setter Property="Foreground" Value="{StaticResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusField}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- NumberField: mono value + unit suffix. -->
  <Style TargetType="c:NumberField">
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:NumberField">
          <Grid>
            <TextBox x:Name="PART_Box" Style="{StaticResource FieldTextBox}" Padding="10,3,32,3" />
            <TextBlock Text="{TemplateBinding Unit}" Style="{StaticResource MonoCaption}" FontSize="11" Foreground="{StaticResource InkTertiaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Utilization bar: a determinate ProgressBar (0..1), 4 px track. Lightweight key thickens the default 1 px track. -->
  <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
  <Style x:Key="UtilizationBarStyle" TargetType="ProgressBar">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>
</ResourceDictionary>
