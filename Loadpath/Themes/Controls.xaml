  </Style>

  <!-- A square toggle with an icon (multi-select in the floating bar): the segment cell's checked wash, on its own. -->
  <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource SegmentToggle}">
    <Setter Property="Width" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="Padding" Value="{StaticResource Inset0}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style x:Key="TouchIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
    <Setter Property="Width" Value="{StaticResource TouchTarget}" />
    <Setter Property="Height" Value="{StaticResource TouchTarget}" />
  </Style>

  <!--
    Switch toggle (Reduce noise): a 30 x 16 track with a sliding knob, then the label content.
    The knob travels 14 px in 200 ms and the accent track cross-fades in 150 ms, both on EaseSmooth.
    Built on ToggleButton rather than ToggleSwitch so the whole labelled cell is the hit target and sits inside a split control.
  -->
  <Style x:Key="SwitchToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Padding" Value="{StaticResource InsetX12}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{ThemeResource LabelSmallFontWeight}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Body.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Checked">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Body.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"><SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="14" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Opacity="0" Background="{ThemeResource SurfaceVariantBrush}" />
            <StackPanel x:Name="Body" Orientation="Horizontal" Spacing="{StaticResource Space10}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
              <Grid Width="{StaticResource SwitchTrackWidth}" Height="{StaticResource SwitchTrackHeight}" VerticalAlignment="Center">
                <Rectangle RadiusX="{StaticResource SwitchTrackRadius}" RadiusY="{StaticResource SwitchTrackRadius}" Fill="{ThemeResource OutlineBrush}" />
                <Rectangle x:Name="TrackOn" Opacity="0" RadiusX="{StaticResource SwitchTrackRadius}" RadiusY="{StaticResource SwitchTrackRadius}" Fill="{ThemeResource PrimaryBrush}" />
                <Ellipse Width="{StaticResource SwitchKnobSize}" Height="{StaticResource SwitchKnobSize}" Fill="{ThemeResource OnPrimaryBrush}" HorizontalAlignment="Left" Margin="{StaticResource KnobMargin}">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="KnobShift" X="0" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="{StaticResource FocusRingInset}"
                    BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="{StaticResource RadiusHairline}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Keycap: a keyboard hint ("F", "CTRL K") inside a button or label. -->
  <Style x:Key="Keycap" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusHairline}" />
    <Setter Property="Padding" Value="{StaticResource KeycapInset}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="KeycapText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource CaptionSmallFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource LineTight}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <!-- Dashed rule: the sheet's separator. A zero-height rectangle so its top and bottom strokes coincide. -->
  <Style x:Key="DashedRule" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Stroke" Value="{ThemeResource OutlineVariantMediumBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Rules between tool groups: across the floating rail, upright in the phone strip. -->
  <Style x:Key="RailRule" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="{StaticResource Inset4x4}" />
    <Setter Property="Fill" Value="{ThemeResource OutlineVariantMediumBrush}" />
  </Style>
  <Style x:Key="StripRule" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="{StaticResource StripRuleInset}" />
    <Setter Property="Fill" Value="{ThemeResource OutlineVariantMediumBrush}" />
  </Style>

  <!-- CheckBox: lightweight keys only (themed, in Tokens.xaml), so the platform template keeps its states and accessibility. -->
  <Style x:Key="LayerCheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="Padding" Value="{StaticResource GapStart8}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Sheet flyout: paper surface, hairline frame, no inner padding (content owns its gutters). -->
  <Style x:Key="SheetFlyoutPresenter" TargetType="FlyoutPresenter">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusField}" />
    <Setter Property="Padding" Value="{StaticResource Inset0}" />
    <Setter Property="MaxWidth" Value="{StaticResource SheetMaxWidth}" />
    <Setter Property="MaxHeight" Value="{StaticResource SheetMaxHeight}" />
  </Style>

  <!-- Numeric field: mono value, unit suffix supplied by the NumberField control around it. -->
  <Style x:Key="FieldTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource FieldInset}" />
    <Setter Property="MinHeight" Value="{StaticResource FieldHeight}" />
    <Setter Property="Height" Value="{StaticResource FieldHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="SelectionHighlightColor" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <!-- Border colour cross-fades (ink on hover, accent on focus) in 150 ms rather than switching. -->
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusHairline}">
              <ScrollViewer x:Name="ContentElement"
                            HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            IsTabStop="False" ZoomMode="Disabled"
                            Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="HoverEdge" Opacity="0" IsHitTestVisible="False" BorderBrush="{ThemeResource OnSurfaceBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusHairline}" />
            <Border x:Name="FocusEdge" Opacity="0" IsHitTestVisible="False" BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusHairline}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{StaticResource Inset0}" />
    <Setter Property="Height" Value="{StaticResource FieldHeight}" />
    <Setter Property="MinHeight" Value="{StaticResource FieldHeight}" />
    <Setter Property="Padding" Value="{StaticResource InsetX8}" />
  </Style>

  <!-- ===== Menus, tooltips ===== -->
  <Style TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPopover}" />
    <Setter Property="Padding" Value="{StaticResource Inset4}" />
    <Setter Property="MinWidth" Value="{StaticResource MenuMinWidth}" />
  </Style>

  <Style x:Key="MenuItemStyle" TargetType="MenuFlyoutItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource InsetX8}" />
    <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Height" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuFlyoutItem">
          <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Content.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Opacity="0" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="{StaticResource RadiusField}" />
            <Grid x:Name="Content" ColumnSpacing="{StaticResource Space16}" Padding="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TextBlock" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" />
              <TextBlock x:Name="KeyboardAcceleratorTextBlock" Grid.Column="1" Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                         Style="{StaticResource MonoCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource MenuItemStyle}" />

  <!--
    Checkable menu items (Reduce noise, the theme choice): the plain item's look plus a check column. One template for
    both: ToggleMenuFlyoutItem and RadioMenuFlyoutItem drive the same Checked / Unchecked states.
  -->
  <ControlTemplate x:Key="CheckMenuItemTemplate" TargetType="MenuFlyoutItem">
    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal">
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Pressed">
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Content.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CheckStates">
          <VisualState x:Name="Unchecked" />
          <VisualState x:Name="Checked">
            <VisualState.Setters>
              <Setter Target="CheckGlyph.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="Hover" Opacity="0" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="{StaticResource RadiusField}" />
      <Grid x:Name="Content" ColumnSpacing="{StaticResource Space8}" Padding="{TemplateBinding Padding}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:Icon x:Name="CheckGlyph" Kind="check" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Opacity="0" Foreground="{ThemeResource PrimaryBrush}" />
        <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                   Style="{StaticResource MonoCaption}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ToggleMenuFlyoutItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource InsetX8}" />
    <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Height" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template" Value="{StaticResource CheckMenuItemTemplate}" />
  </Style>

  <Style TargetType="RadioMenuFlyoutItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource InsetX8}" />
    <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Height" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template" Value="{StaticResource CheckMenuItemTemplate}" />
  </Style>

  <!-- Menu rows sized for a fingertip: the title overflow menu and context menus opened by a long press. -->
  <Style x:Key="TouchMenuItem" TargetType="MenuFlyoutItem" BasedOn="{StaticResource MenuItemStyle}">
    <Setter Property="Padding" Value="{StaticResource InsetX12}" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
    <Setter Property="Height" Value="{StaticResource TouchTarget}" />
  </Style>
  <Style x:Key="TouchToggleMenuItem" TargetType="ToggleMenuFlyoutItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource InsetX12}" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
    <Setter Property="Height" Value="{StaticResource TouchTarget}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template" Value="{StaticResource CheckMenuItemTemplate}" />
  </Style>
  <Style x:Key="TouchRadioMenuItem" TargetType="RadioMenuFlyoutItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="Padding" Value="{StaticResource InsetX12}" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
    <Setter Property="Height" Value="{StaticResource TouchTarget}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template" Value="{StaticResource CheckMenuItemTemplate}" />
  </Style>

  <Style TargetType="MenuFlyoutSeparator">
    <Setter Property="Background" Value="{ThemeResource OutlineVariantMediumBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="{StaticResource Inset4x4}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuFlyoutSeparator">
          <Rectangle Fill="{TemplateBinding Background}" Height="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{ThemeResource SurfaceInverseBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceInverseBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SurfaceInverseBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="FontFamily" Value="{ThemeResource CaptionSmallFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource CaptionSmallFontSize}" />
    <Setter Property="Padding" Value="{StaticResource Inset8x4}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusField}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- NumberField: mono value + unit suffix. -->
  <Style TargetType="c:NumberField">
    <Setter Property="Height" Value="{StaticResource FieldHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:NumberField">
          <Grid>
            <TextBox x:Name="PART_Box" Style="{StaticResource FieldTextBox}" Padding="{StaticResource FieldInsetWithUnit}" />
            <TextBlock Text="{TemplateBinding Unit}" Style="{StaticResource MonoSmall}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource UnitSuffixMargin}" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Utilization bar: a determinate ProgressBar (0..1), 4 px track. Lightweight key thickens the default 1 px track. -->
  <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
  <Style x:Key="UtilizationBarStyle" TargetType="ProgressBar">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="MinHeight" Value="{StaticResource UtilizationTrackHeight}" />
    <Setter Property="Height" Value="{StaticResource UtilizationTrackHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusHairline}" />
    <Setter Property="Background" Value="{ThemeResource OutlineVariantMediumBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>
</ResourceDictionary>
