<!-- Control styles. Every interactive element: Normal / PointerOver / Pressed / Disabled, plus visible keyboard focus. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Loadpath.Controls">

  <!--
    ===== Text =====
    The design's ramp is the theme's type scale (Styles/TypographyOverride.xaml over DefaultFontFamily Inter). The role
    styles are based on the semantic styles (BodyMedium, LabelSmall...) and add the role's colour, the design's line
    height and one line; the mono ones swap in MonoFontFamily for figures and sheet labels. Simple's implicit TextBlock
    style sets OnSurfaceBrush and wrapping, so every TextBlock in the app names a style: ButtonLabel, colourless, for
    text that takes its colour from the button it sits in.
  -->
  <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineBody}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineCaption}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineDisplay}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="MediumText" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineBody}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Mono: figures and the drawing sheet's labels -->
  <!-- A value: mono at the body size. -->
  <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineBody}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- A secondary figure or caption in mono. -->
  <Style x:Key="MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineCaption}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- An id or a strong caption (N1, M12, the status chip): mono medium at the caption size, ink. -->
  <Style x:Key="MonoLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineCaption}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- Micro text: counts, group titles in sheets, chip labels. -->
  <Style x:Key="MonoSmall" TargetType="TextBlock" BasedOn="{StaticResource CaptionSmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineCaption}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- Text inside a pill or under a tile: micro text on a tight line. -->
  <Style x:Key="PillText" TargetType="TextBlock" BasedOn="{StaticResource MonoSmall}">
    <Setter Property="LineHeight" Value="{StaticResource LineMicro}" />
  </Style>
  <!-- Section label: mono medium, small, the "01 Position" register of the drawing sheet. -->
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelExtraSmall}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineLabel}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- The wordmark: mono medium at the large label size, in the accent. -->
  <Style x:Key="WordmarkText" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- A label inside a button: mono medium at the label size and no colour, so it keeps the button's. -->
  <Style x:Key="ButtonLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{ThemeResource LabelSmallFontWeight}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Label above a numeric field (inspector, presets). -->
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MonoSmall}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Margin" Value="{StaticResource GapBottom8}" />
  </Style>

  <!-- ===== Pills (read-only badges) ===== -->
  <Style x:Key="PillBorder" TargetType="Border">
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="{StaticResource PillInset}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="DangerPill" TargetType="Border" BasedOn="{StaticResource PillBorder}">
    <Setter Property="Background" Value="{ThemeResource ErrorContainerBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ErrorLowBrush}" />
  </Style>

  <!-- Capacity pill in the status bar: a raised chip, red-washed when something fails. -->
  <Style x:Key="StatusPill" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource RowHeightCompact}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusRound}" />
    <Setter Property="Padding" Value="{StaticResource InsetX12}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="Padding" Value="{StaticResource InsetX8}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusField}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="RootScale" />
            </Grid.RenderTransform>
            <!-- Hover wash fades 150 ms, press settles to 0.98, both on EaseSmooth. -->
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- Hover wash over any background: darkens light chrome and the accent fill alike. -->
            <Border x:Name="Hover" Opacity="0" IsHitTestVisible="False" Background="{ThemeResource OnSurfaceHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="{StaticResource FocusRingOutset}"
                    BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="{StaticResource RadiusPopover}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{ThemeResource LabelSmallFontWeight}" />
    <Setter Property="Padding" Value="{StaticResource InsetX18}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
  </Style>

  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{ThemeResource LabelSmallFontWeight}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
  </Style>

  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{ThemeResource LabelSmallFontWeight}" />
    <Setter Property="Padding" Value="{StaticResource InsetX12}" />
  </Style>

  <Style x:Key="DangerTextButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Foreground" Value="{ThemeResource ErrorBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{ThemeResource LabelSmallFontWeight}" />
    <Setter Property="Padding" Value="{StaticResource Inset0}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
    <Setter Property="Padding" Value="{StaticResource Inset0}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!--
    List rows that act (outline rows, command palette rows, section chips): real buttons, so the keyboard reaches them
    (Tab, Enter, Space), screen readers name them, and they show the hover wash and focus ring like every other button.
  -->
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Height" Value="{StaticResource RowHeight}" />
    <Setter Property="MinHeight" Value="{StaticResource RowHeight}" />
    <Setter Property="Padding" Value="{StaticResource OutlineRowInset}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="{StaticResource Inset0}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusNone}" />
  </Style>
  <Style x:Key="PaletteRowButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Padding" Value="{StaticResource InsetX8}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="{StaticResource Inset0}" />
  </Style>
  <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusHairline}" />
    <Setter Property="Padding" Value="{StaticResource Inset6x3}" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="MinHeight" Value="{StaticResource ChipMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Icon button sized for a fingertip (phone layout). -->
  <Style x:Key="TouchIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="{StaticResource TouchTarget}" />
    <Setter Property="Height" Value="{StaticResource TouchTarget}" />
    <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
  </Style>

  <!-- Tool palette button: 40 px, icon follows Foreground, single-key label in the bottom-right corner. -->
  <Style x:Key="ToolButtonStyle" TargetType="c:ToolButton">
    <Setter Property="Width" Value="{StaticResource ToolButtonSize}" />
    <Setter Property="Height" Value="{StaticResource ToolButtonSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ToolButton">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="RootScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.98" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <!-- The active tool's wash cross-fades in 150 ms rather than switching. -->
              <VisualStateGroup x:Name="ActiveStates">
                <VisualState x:Name="Inactive">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActiveWash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Active">
                  <VisualState.Setters>
                    <Setter Target="Key.Foreground" Value="{ThemeResource PrimaryBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActiveWash" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Focused">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.22,1 0.36,1" /></DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}" />
            <Border x:Name="ActiveWash" Opacity="0" IsHitTestVisible="False" Background="{ThemeResource PrimaryContainerBrush}"
                    BorderBrush="{ThemeResource PrimaryVariantLightBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusField}" />
            <Border x:Name="Hover" Opacity="0" IsHitTestVisible="False" Background="{ThemeResource OnSurfaceHoverBrush}" CornerRadius="{StaticResource RadiusField}" />
            <c:Icon x:Name="Glyph" Kind="{TemplateBinding IconKind}" Foreground="{TemplateBinding Foreground}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}" Margin="{StaticResource ToolGlyphMargin}" />
            <TextBlock x:Name="Key" Text="{TemplateBinding KeyLabel}" Style="{StaticResource MonoSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource ToolKeyLabelMargin}" IsHitTestVisible="False" />
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="{StaticResource FocusRingOutset}"
                    BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="{StaticResource RadiusPopover}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="c:ToolButton" BasedOn="{StaticResource ToolButtonStyle}" />
  <!-- The bottom tool strip on a phone: 44 px fingertip targets. -->
  <Style x:Key="TouchToolButton" TargetType="c:ToolButton" BasedOn="{StaticResource ToolButtonStyle}">
    <Setter Property="Width" Value="{StaticResource TouchTarget}" />
    <Setter Property="Height" Value="{StaticResource TouchTarget}" />
  </Style>

  <!--
    Segment toggle: one cell of a joined segmented control (display mode, support kind). Uppercase mono label;
    the checked cell's accent wash and outline cross-fade in 150 ms on EaseSmooth. The group Border draws the outer frame.
  -->
  <Style x:Key="SegmentToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Padding" Value="{StaticResource InsetX14}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
