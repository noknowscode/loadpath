<Application x:Class="Loadpath.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls"
             xmlns:utus="using:Uno.Toolkit.UI.Simple">
  <Application.Resources>
    <ResourceDictionary>
      <c:BoolToVisibilityConverter x:Key="Vis" />
      <c:TextToVisibilityConverter x:Key="VisText" />
      <c:KeyToBrushConverter x:Key="Brush" />
      <c:BoolToBrushConverter x:Key="Pick" />
      <c:UpperCaseConverter x:Key="Upper" />
      <c:BoolToDimConverter x:Key="Dim" />
      <c:NullableBoolConverter x:Key="Checked" />
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- The look comes from the Simple theme. Its palette is the design's, in Styles/ColorPaletteOverride.xaml (the
             file Uno Platform Studio's Themes tab edits); pages, styles and the canvas use the role brushes it
             generates (OnSurfaceBrush, PrimaryBrush, OutlineVariantBrush...). The type is Inter (DefaultFontFamily) on
             the design's ramp (Styles/TypographyOverride.xaml), with JetBrains Mono for figures. Spacing runs on an
             8 px unit (Space025 = 2 ... Space250 = 20) and radii on 4 (Radius050 = 2: fields and segments,
             Radius100 = 4: buttons, Radius200 = 8: popovers, RadiusFull: pills). -->
        <utus:SimpleToolkitTheme DefaultSpacing="8" DefaultCornerRadius="4" DefaultDensity="Regular"
                                 DefaultFontFamily="ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter"
                                 FontOverrideSource="ms-appx:///Styles/TypographyOverride.xaml">
          <utus:SimpleToolkitTheme.Colors>
            <ut:ThemeColors xmlns:ut="using:Uno.Themes" OverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
          </utus:SimpleToolkitTheme.Colors>
        </utus:SimpleToolkitTheme>
        <ResourceDictionary Source="ms-appx:///Themes/Layout.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        The colour no palette role covers, and the canvas's per-theme alphas. Every colour with a role (paper, ink,
        accent, failure, rules) is the palette's, used through the role's brush; the structure itself is drawn in Primary.
        Pages take these through {ThemeResource}; code (the canvas palette, the brush-key converters) resolves them per
        theme through Controls/ThemeLookup and re-reads them on ActualThemeChanged. "Default" is the Dark dictionary.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Warn: the amber middle of the utilization ramp (75 % and up) between Primary and Error. With the ramp's
               percent labels it stays readable without hue: 5.0:1 on the paper. -->
          <Color x:Key="WarnColor">#FF93600F</Color>
          <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />

          <!-- Canvas alphas (Skia bakes opacity into paints). Dimmed members, dimmed supports and loads, hover halos,
               the plate behind force labels, the marquee fill, dimension lines and the frame tags; and how much of
               Primary goes into the paper for construction lines (frame, grid crosses, extension lines) and grid dots. -->
          <x:Double x:Key="CanvasDimAlpha">0.3</x:Double>
          <x:Double x:Key="CanvasDimInkAlpha">0.35</x:Double>
          <x:Double x:Key="CanvasHaloAlpha">0.6</x:Double>
          <x:Double x:Key="CanvasPlateAlpha">0.85</x:Double>
          <x:Double x:Key="CanvasMarqueeAlpha">0.06</x:Double>
          <x:Double x:Key="CanvasDimLineAlpha">0.75</x:Double>
          <x:Double x:Key="CanvasTagAlpha">0.8</x:Double>
          <x:Double x:Key="CanvasConstructionAlpha">0.32</x:Double>
          <x:Double x:Key="CanvasGridAlpha">0.21</x:Double>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
          <Color x:Key="WarnColor">#FFE3A64B</Color>
          <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />

          <!-- Low alphas sink into a dark ground faster than into paper, so dimmed ink stays a little stronger. -->
          <x:Double x:Key="CanvasDimAlpha">0.38</x:Double>
          <x:Double x:Key="CanvasDimInkAlpha">0.42</x:Double>
          <x:Double x:Key="CanvasHaloAlpha">0.7</x:Double>
          <x:Double x:Key="CanvasPlateAlpha">0.9</x:Double>
          <x:Double x:Key="CanvasMarqueeAlpha">0.12</x:Double>
          <x:Double x:Key="CanvasDimLineAlpha">0.8</x:Double>
          <x:Double x:Key="CanvasTagAlpha">0.85</x:Double>
          <x:Double x:Key="CanvasConstructionAlpha">0.34</x:Double>
          <x:Double x:Key="CanvasGridAlpha">0.22</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- An unselected row: the key the model hands the brush converter when a row has no fill. -->
      <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
