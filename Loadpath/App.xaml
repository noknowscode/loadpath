<Application x:Class="Loadpath.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls">
  <Application.Resources>
    <ResourceDictionary>
      <c:BoolToVisibilityConverter x:Key="Vis" />
      <c:TextToVisibilityConverter x:Key="VisText" />
      <c:KeyToBrushConverter x:Key="Brush" />
      <c:BoolToBrushConverter x:Key="Pick" />
      <c:UpperCaseConverter x:Key="Upper" />
      <c:BoolToDimConverter x:Key="Dim" />
      <c:NullableBoolConverter x:Key="Checked" />
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/MotionTokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
